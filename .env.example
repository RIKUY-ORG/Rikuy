# ═══════════════════════════════════════════════════════════════
# RIKUY NETWORK - Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# NETWORK SELECTION
# ═══════════════════════════════════════════════════════════════
# Options: arbitrum, rikuy
NETWORK=rikuy

# ═══════════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════════
PORT=3001
NODE_ENV=development
DEV_MODE=true

# ═══════════════════════════════════════════════════════════════
# WALLET (Backend Relayer)
# ═══════════════════════════════════════════════════════════════
RELAYER_PRIVATE_KEY=0x_your_backend_relayer_private_key

# ═══════════════════════════════════════════════════════════════
# ARBITRUM SEPOLIA (L2 Parent Chain)
# Chain ID: 421614
# ═══════════════════════════════════════════════════════════════
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_CHAIN_ID=421614
ARBITRUM_RIKUY_CORE_ADDRESS=
ARBITRUM_REPORT_REGISTRY_ADDRESS=
ARBITRUM_GOVERNMENT_REGISTRY_ADDRESS=

# ═══════════════════════════════════════════════════════════════
# RIKUY CHAIN L3 (Arbitrum Orbit - Target Network)
# Chain ID: 313370
# ═══════════════════════════════════════════════════════════════
RIKUY_CHAIN_RPC_URL=
RIKUY_CHAIN_ID=313370
RIKUY_CHAIN_EXPLORER_URL=
RIKUY_CHAIN_RIKUY_CORE_ADDRESS=
RIKUY_CHAIN_REPORT_REGISTRY_ADDRESS=
RIKUY_CHAIN_GOVERNMENT_REGISTRY_ADDRESS=
RIKUY_CHAIN_ANONYMOUS_REPORT_ADDRESS=

# ═══════════════════════════════════════════════════════════════
# IPFS (Pinata)
# Get keys at: https://app.pinata.cloud/
# ═══════════════════════════════════════════════════════════════
PINATA_JWT=your_pinata_jwt_token
PINATA_GATEWAY=https://gateway.pinata.cloud

# ═══════════════════════════════════════════════════════════════
# ARKIV (Permanent Storage)
# ═══════════════════════════════════════════════════════════════
ARKIV_RPC_URL=https://mendoza.hoodi.arkiv.network/rpc
ARKIV_PRIVATE_KEY=0x_your_arkiv_wallet_private_key

# ═══════════════════════════════════════════════════════════════
# AI PROVIDERS
# ═══════════════════════════════════════════════════════════════
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
CLAUDE_API_KEY=your_claude_api_key

# ═══════════════════════════════════════════════════════════════
# SECURITY
# ═══════════════════════════════════════════════════════════════
JWT_SECRET=your_jwt_secret_here
MAX_FILE_SIZE=10485760
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=5

# ═══════════════════════════════════════════════════════════════
# REDIS (Optional - for caching)
# ═══════════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════════════════
# BLOCK EXPLORER API KEYS (For contract verification)
# ═══════════════════════════════════════════════════════════════
ARBISCAN_API_KEY=your_arbiscan_api_key
RIKUY_EXPLORER_API_KEY=
RIKUY_EXPLORER_API_URL=

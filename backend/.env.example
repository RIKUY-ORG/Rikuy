# Entorno y servidor
NODE_ENV=production
PORT=3001

# Seguridad / Autenticación
JWT_SECRET=rikuy-super-secret-jwt-key-min-32-chars-2024-prod
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=60000

# Archivos / Storage
MAX_FILE_SIZE=10485760
PINATA_GATEWAY=https://gateway.pinata.cloud
PINATA_JWT=your-pinata-jwt-token

# Blockchain / Contratos (Rikuy Chain L3)
ARKIV_PRIVATE_KEY=your-arkiv-private-key
RELAYER_PRIVATE_KEY=your-relayer-private-key
ARKIV_RPC_URL=https://mendoza.hoodi.arkiv.network/rpc
RIKUY_CHAIN_ID=313370
RIKUY_CHAIN_RPC_URL=your-rikuy-chain-rpc-url

GOVERNMENT_REGISTRY_ADDRESS=your-government-registry-address
REPORT_REGISTRY_ADDRESS=your-report-registry-address
RIKUY_CORE_V2_ADDRESS=your-rikuy-core-v2-address
ANONYMOUS_REPORT_ADDRESS=your-anonymous-report-stylus-address

# Integraciones externas
GEMINI_API_KEY=your-gemini-api-key

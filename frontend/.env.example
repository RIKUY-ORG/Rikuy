########################################
# Privy (Autenticación / Identidad)
########################################
# ID de la aplicación en Privy
VITE_PRIVY_APP_ID="your-privy-app-id"

# Client ID de Privy (para OAuth / login)
VITE_PRIVY_CLIENT_ID="your-privy-client-id"


########################################
# Backend API
########################################
# URL pública del backend (Railway, Render, etc.)
VITE_BACKEND_API_URL="https://localhost:3001"


########################################
# Blockchain / Smart Contracts (Rikuy Chain)
########################################
# Chain ID de Rikuy Chain L3
VITE_RIKUY_CHAIN_ID="313370"

# RPC URL de Rikuy Chain L3
VITE_RIKUY_CHAIN_RPC_URL=""

# Dirección del contrato principal Rikuy Core V2
VITE_RIKUY_CORE_ADDRESS="0x0000000000000000000000000000000000000000"

# Dirección del contrato AnonymousReport (Stylus)
VITE_ANONYMOUS_REPORT_ADDRESS="0x0000000000000000000000000000000000000000"

# Dirección del GovernmentRegistry
VITE_GOVERNMENT_REGISTRY_ADDRESS="0x0000000000000000000000000000000000000000"
